{
	"name": "pi-cc-extensions",
	"version": "0.8.37",
	"description": "A Pi productivity suite with Claude Code-style UI, fixed editor, context inspection, and agent/session references",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"claude-code",
		"fixed-editor"
	],
	"homepage": "https://github.com/minuque/pi-cc-extensions#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/minuque/pi-cc-extensions.git"
	},
	"bugs": {
		"url": "https://github.com/minuque/pi-cc-extensions/issues"
	},
	"files": [
		"extensions",
		"assets/readme",
		"themes",
		"README.md",
		"README.en.md"
	],
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		],
		"themes": [
			"./themes/github-dark-default.json"
		],
		"image": "https://raw.githubusercontent.com/minuque/pi-cc-extensions/main/assets/readme/welcome.webp"
	},
	"scripts": {
		"test": "node --test tests/**/*.test.ts",
		"typecheck": "node scripts/typecheck.mjs",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"preversion": "npm run format:check && npm run typecheck && npm test",
		"release": "npm version patch && npm publish",
		"release:minor": "npm version minor && npm publish",
		"release:major": "npm version major && npm publish"
	},
	"dependencies": {
		"@shikijs/cli": "^4.0.2",
		"@tifan/pi-fixed-editor": "^0.2.5",
		"jiti": "^2.7.0",
		"pi-compact-thinking": "^0.2.0"
	},
	"bundledDependencies": [
		"@tifan/pi-fixed-editor"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^26.1.1"
	}
}
